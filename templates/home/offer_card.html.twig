<div class="product-card">
    <img src="{{ offer.product.image }}" class="product-img" alt="product image">
    <h5 class="product-title fw-bold">{{offer.product.name}}</h5>
    <p class="product-reference text-muted">Ref: {{offer.product.reference}}</p>
    <p class="product-price text-success fs-5 fw-bold">Starting at {{offer.price}} TND</p>
    <a href="{{ path('product_detail', { id: offer.product.id }) }}"
       class="product-details-btn">
        View details
    </a>
    <button class="product-bookmark-btn" data-reference="{{ offer.product.reference }}"></button>
</div>
