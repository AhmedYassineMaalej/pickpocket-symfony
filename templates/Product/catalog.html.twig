{% extends 'base.html.twig' %}

{% block title %}Pickpocket | Catalog{% endblock %}

{% block body %}

    {# HEADER #}
    <header class="catalog-header text-white text-center py-5">
        <div class="container">
            <h1 class="display-4 fw-bold">📦 Product Catalog</h1>
            <p class="lead mb-0">
                {% if currentCategory %}
                    Browsing: {{ currentCategory.name }}
                {% elseif query %}
                    Results for "{{ query }}"
                {% else %}
                    Compare prices and choose where to buy the best deals!
                {% endif %}
            </p>
        </div>
    </header>

    <div class="catalog-layout">

        <aside class="sidebar">

            {# PRICE FILTER #}
            <div class="filter-section">
                <h4>Price</h4>
                <div class="price-inputs">
                    <input type="number" id="minPriceInput"
                           value="{{ app.request.query.get('minPrice', 0) }}"
                           onchange="applyFilters()">
                    <input type="number" id="maxPriceInput"
                           value="{{ app.request.query.get('maxPrice', 1000000) }}"
                           onchange="applyFilters()">
                </div>
            </div>

            {# CATEGORY FILTER #}
            <div class="filter-section">
                <h4>Category</h4>
                <select id="category" onchange="applyFilters()">
                    <option value="">All</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}"
                            {{ app.request.query.get('category') == (cat.id ~ '') ? 'selected="selected"' : '' }}>
                            {{ cat.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

        </aside>

        {# PRODUCTS #}
        <main class="catalog-products">
            <div class="container mb-5">

                {% if products is empty %}
                    <div class="alert alert-info mt-4">
                        No products found
                        {% if query %} for "<strong>{{ query }}</strong>"{% endif %}
                        {% if currentCategory %} in <strong>{{ currentCategory.name }}</strong>{% endif %}.
                    </div>
                {% else %}
                    <div class="products-container">
                        {% for product in products %}

                            {# FIND THE CHEAPEST OFFER #}
                            {% set bestOffer = null %}
                            {% for offer in product.offers %}
                                {% if bestOffer is null or offer.price < bestOffer.price %}
                                    {% set bestOffer = offer %}
                                {% endif %}
                            {% endfor %}

                            <div class="product-card">
                                <img src="{{ product.image }}" class="product-img" alt="{{ product.name }}">
                                <h5 class="product-title fw-bold">{{ product.name }}</h5>
                                <p class="product-reference text-muted">Ref: {{ product.reference }}</p>
                                <p class="product-price text-success fs-5 fw-bold">
                                    {% if bestOffer %}
                                        Starting at {{ bestOffer.price|number_format(2) }} TND
                                    {% else %}
                                        No offers yet
                                    {% endif %}
                                </p>
                                <a href="{{ path('app_product_detail', { id: product.id }) }}"
                                   class="btn btn-primary flex-grow-1">
                                    View details
                                </a>
                                <button class="product-bookmark-btn"
                                        onclick="toggleBookmark('{{ product.reference }}', this)">
                                    <img src="/bookmark-empty.svg">
                                </button>
                            </div>

                        {% endfor %}
                    </div>
                {% endif %}

            </div>
        </main>

    </div>

    <script src="/js/filters.js"></script>

{% endblock %}
